{
  "name": "frhios",
  "version": "0.1.0",
  "description": "Interface tactile domotique (Home Assistant) pour PC kiosque",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "kiosk": "env -u ELECTRON_RUN_AS_NODE electron . --kiosk",
    "web": "python3 -m http.server 8765 --bind 127.0.0.1"
  },
  "devDependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "electron": "45.4.1"
  }
}
