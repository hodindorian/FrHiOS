# Miroirs pacman de FrHiOS (le fichier d'origine d'Arch a tous ses serveurs en commentaire).
# Pour en changer : sudo nano /etc/pacman.d/mirrorlist, puis sudo pacman -Syyu
# Le premier est un répartiteur géographique qui choisit un miroir proche.
Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch
Server = https://mirrors.kernel.org/archlinux/$repo/os/$arch
Server = https://mirror.rackspace.com/archlinux/$repo/os/$arch
